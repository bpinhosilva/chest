#!/usr/bin/env bash
# chest - Simple archive, encrypt, and restore script for Linux
set -euo pipefail

# ==============================================================================
# DEFAULT EXCLUDES (Edit this list directly or pass -e / --exclude via CLI)
# ==============================================================================
DEFAULT_EXCLUDES=(
  ".cache"
  "Cache"
  "Code Cache"
  "cache2"
  "tmp"
  "temp"
  "*.tmp"
  "*.temp"
  "*.swp"
  "*~"
  ".local/share/Trash"
  ".Trash-*"
  "node_modules"
  "__pycache__"
  ".pytest_cache"
  ".venv"
  "venv"
  "lost+found"
)

# ==============================================================================
# EXCLUDE FILE (optional): $HOME/.config/chest/excludes or -E / --exclude-file FILE
# One pattern per line; blank lines and lines starting with '#' are ignored.
# ==============================================================================
EXCLUDE_FILE_PATTERNS=()

trim() {
  local v="$1"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  printf '%s' "$v"
}

# Read a one-pattern-per-line exclude file into EXCLUDE_FILE_PATTERNS
load_exclude_file() {
  local file="$1" line
  [ -r "$file" ] || die "Exclude file '$file' is not readable."
  EXCLUDE_FILE_PATTERNS=()
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    line="$(trim "$line")"
    [ -z "$line" ] && continue
    [[ "$line" == \#* ]] && continue
    EXCLUDE_FILE_PATTERNS+=("$line")
  done < "$file"
}

usage() {
  cat <<'EOF'
Usage:
  chest backup  [-s SOURCE_DIR] [-o OUTPUT_PATH] [-p PASSWORD | -r RECIPIENT ...] [-e PATTERN ...] [--no-default-excludes] [-E FILE] [--no-exclude-file] [--dry-run] [-v]
  chest restore -i ARCHIVE_FILE [-o RESTORE_DIR] [-p PASSWORD] [-v]

Commands:
  backup    Archive, compress (tar.gz), and encrypt (AES-256) a directory
  restore   Decrypt and extract an encrypted backup archive

Backup Options:
  -s, --source DIR          Directory to back up (default: $HOME)
  -o, --output PATH         Output directory or .tar.gz.gpg file path (default: $HOME/backups)
  -p, --password PASS       Encryption password for symmetric encryption
                            (prompts interactively if omitted; $CHEST_PASSWORD is used if set)
  -r, --recipient KEY       Encrypt to a GPG public key instead of a password
                            (key ID, fingerprint, or email; can be used multiple times).
                            Restoring needs the matching private key; no password is
                            required on the backup machine. Mutually exclusive with -p.
  -e, --exclude PATTERN     Exclude directory/file pattern (can be used multiple times)
      --no-default-excludes Do not use the built-in default excludes (exclude file and -e patterns still apply)
  -E, --exclude-file FILE   File with one exclude pattern per line (default: $HOME/.config/chest/excludes, optional)
      --no-exclude-file     Ignore the exclude file entirely
  -n, --dry-run             Show estimated backup size in GB (after excludes) without backing up
  -v, --verbose             Print each file path as it is backed up

Restore Options:
  -i, --input FILE          Encrypted .tar.gz.gpg file to restore (required)
  -o, --output DIR          Directory to extract files into (default: ./restored)
  -p, --password PASS       Decryption password for symmetric archives
                            (prompts interactively if omitted; $CHEST_PASSWORD is used if set)
  -v, --verbose             Print each file path as it is restored

The archive type (symmetric password vs. GPG public key) is detected
automatically during restore; no extra flag is needed. $CHEST_PASSWORD is
only used for symmetric (password) archives: public-key archives need no
password, gpg-agent handles the private key.

Examples:
  # Preview estimated backup size in GB
  chest backup -s ~/Documents --dry-run

  # Backup a folder with a CLI password, extra excludes, and verbose file output
  chest backup -s ~/Documents -o ~/backups -p "mysecret" -e "*.iso" -v

  # Backup encrypted to a GPG public key (passwordless, ideal for unattended runs)
  chest backup -s ~/Documents -o ~/backups -r you@example.com

  # Restore a backup (password or private key is picked up automatically)
  chest restore -i ~/backups/Documents_20261017_120000.tar.gz.gpg -o /tmp/restore -p "mysecret"
EOF
}

die() {
  echo "Error: $*" >&2
  exit 1
}

need_arg() {
  [ $# -ge 2 ] && [ -n "$2" ] || die "Option '$1' requires an argument."
}

ask_password() {
  local mode="${1:-}"
  if [ -z "$password" ]; then
    printf "Enter password: " >&2
    if [ -t 0 ]; then
      read -rs password
      echo >&2
      if [ "$mode" = "backup" ]; then
        local confirm=""
        printf "Confirm password: " >&2
        read -rs confirm
        echo >&2
        [ "$password" = "$confirm" ] || die "Passwords do not match."
      fi
    else
      read -r password || read -rs password </dev/tty
      echo >&2
    fi
    [ -n "$password" ] || die "Password cannot be empty."
  fi
}

cmd_backup() {
  local src="$HOME"
  local out="$HOME/backups"
  local password="${CHEST_PASSWORD:-}"
  local password_flag=0
  local use_defaults=1
  local dry_run=0
  local verbose=0
  local cli_excludes=()
  local exclude_file=""
  local use_exclude_file=1
  local recipients=()

  while [ $# -gt 0 ]; do
    case "$1" in
      -s|--source)   need_arg "$@"; src="$2"; shift 2 ;;
      -o|--output)   need_arg "$@"; out="$2"; shift 2 ;;
      -p|--password) need_arg "$@"; password="$2"; password_flag=1; shift 2 ;;
      -r|--recipient) need_arg "$@"; recipients+=("$2"); shift 2 ;;
      -e|--exclude)  need_arg "$@"; cli_excludes+=("$2"); shift 2 ;;
      --no-default-excludes) use_defaults=0; shift ;;
      --no-exclude-file) use_exclude_file=0; shift ;;
      -E|--exclude-file) need_arg "$@"; exclude_file="$2"; shift 2 ;;
      -n|--dry-run)  dry_run=1; shift ;;
      -v|--verbose)  verbose=1; shift ;;
      -h|--help)     usage; exit 0 ;;
      *)             die "Unknown option: $1" ;;
    esac
  done

  if [ "${#recipients[@]}" -gt 0 ] && [ "$password_flag" -eq 1 ]; then
    die "Choose one encryption mode: -p/--password (symmetric) or -r/--recipient (GPG public key), not both."
  fi

  # CHEST_PASSWORD only ever means "the symmetric passphrase": drop any
  # inherited value in public-key mode so it can never be mistaken for the
  # private key's passphrase.
  if [ "${#recipients[@]}" -gt 0 ]; then
    password=""
    local key_matches
    for r in "${recipients[@]}"; do
      key_matches="$(gpg --batch --with-colons --list-keys "$r" 2>/dev/null | grep -c '^pub:')" || key_matches=0
      [ "${key_matches:-0}" -gt 0 ] || die "No public key matches recipient '$r'."
      if [ "$key_matches" -gt 1 ]; then
        echo "Warning: recipient '$r' matches $key_matches public keys; gpg encrypts to all of them. Use a fingerprint to be explicit." >&2
      fi
    done
  fi

  [ -d "$src" ] || die "Source directory '$src' does not exist."

  local real_src
  real_src="$(realpath "$src")"
  local parent_dir
  parent_dir="$(dirname "$real_src")"
  local base_name
  base_name="$(basename "$real_src")"
  if [ "$real_src" = "/" ]; then
    parent_dir="/"
    base_name="."
  fi

  # Resolve exclude file: explicit -E must exist; default path is optional; --no-exclude-file skips it
  local exclude_file_set=0
  if [ "$use_exclude_file" -eq 1 ]; then
    if [ -n "$exclude_file" ]; then
      [ -f "$exclude_file" ] || die "Exclude file '$exclude_file' does not exist."
    elif [ -f "$HOME/.config/chest/excludes" ]; then
      exclude_file="$HOME/.config/chest/excludes"
    fi
    if [ -n "$exclude_file" ]; then
      load_exclude_file "$exclude_file"
      exclude_file_set=1
    fi
  fi

  # Base list: exclude file patterns replace the built-in defaults when a file is used.
  # --no-default-excludes only disables built-in defaults, never exclude-file/-e patterns.
  local base_excludes=()
  if [ "$exclude_file_set" -eq 1 ]; then
    base_excludes=("${EXCLUDE_FILE_PATTERNS[@]}")
    if [ "${#base_excludes[@]}" -eq 0 ]; then
      local note=""
      [ "$use_defaults" -eq 1 ] && note=" (directories containing CACHEDIR.TAG are still skipped)"
      echo "Warning: exclude file '$exclude_file' has no patterns; no exclusions have been used${note}." >&2
    fi
  elif [ "$use_defaults" -eq 1 ]; then
    base_excludes=("${DEFAULT_EXCLUDES[@]}")
  fi

  # Build tar exclude flags
  local exclude_args=()
  for pat in "${base_excludes[@]}"; do
    exclude_args+=(--exclude="$pat")
  done
  if [ "$use_defaults" -eq 1 ]; then
    exclude_args+=(--exclude-caches-under)
    if [ "$real_src" = "/" ]; then
      exclude_args+=(--exclude="./proc" --exclude="./sys" --exclude="./dev" --exclude="./run")
    fi
  fi
  for pat in "${cli_excludes[@]}"; do
    exclude_args+=(--exclude="$pat")
  done

  # Exclude the output directory (or output file) if it resides inside the source directory
  local real_out
  real_out="$(realpath -m "$out")"
  if [[ "$real_out" == "$real_src"/* ]]; then
    exclude_args+=(--exclude="${base_name}/${real_out#"$real_src"/}")
  fi

  if [ "$dry_run" -eq 1 ]; then
    local bytes
    bytes="$(LC_ALL=C tar --totals --warning=no-file-changed --ignore-failed-read -cf /dev/null "${exclude_args[@]}" -C "$parent_dir" "$base_name" 2>&1 \
      | awk '/^Total bytes written:/ {print $4}')"
    bytes="${bytes:-0}"
    awk -v b="$bytes" -v s="$real_src" 'BEGIN {
      printf "Dry run for: %s\n", s
      printf "Uncompressed size (after excludes): %.2f GB (%.2f MB / %d bytes)\n", b/1073741824, b/1048576, b
      printf "Estimated compressed archive size:  ~%.2f GB - %.2f GB\n", (b*0.35)/1073741824, (b*0.65)/1073741824
    }'
    return 0
  fi

  if [ "${#recipients[@]}" -eq 0 ]; then
    ask_password backup
  fi

  # Determine output archive filename
  local archive_file=""
  if [[ "$out" == *.gpg || "$out" == *.enc ]]; then
    mkdir -p "$(dirname "$out")"
    archive_file="$out"
  else
    mkdir -p "$out"
    local prefix="$base_name"
    [ "$prefix" = "." ] && prefix="root"
    archive_file="${out%/}/${prefix}_$(date +%Y%m%d_%H%M%S).tar.gz.gpg"
  fi

  local progress_args=(--totals)
  if [ "$verbose" -eq 1 ]; then
    progress_args+=(-v)
  elif [ -t 2 ]; then
    progress_args+=(--checkpoint=2500 --checkpoint-action='ttyout=  Progress: %T\r')
  fi

  echo "Backing up '$real_src' -> '$archive_file'..."
  umask 077
  trap 'rm -f "$archive_file"' INT TERM EXIT
  set +e
  if [ "${#recipients[@]}" -gt 0 ]; then
    local gpg_args=()
    for r in "${recipients[@]}"; do
      gpg_args+=(--recipient "$r")
    done
    tar --warning=no-file-changed --ignore-failed-read "${progress_args[@]}" -czpf - "${exclude_args[@]}" -C "$parent_dir" "$base_name" \
      | gpg --batch --yes --quiet --no-tty \
            --trust-model always \
            --encrypt --cipher-algo AES256 \
            "${gpg_args[@]}" \
            --output "$archive_file"
  else
    tar --warning=no-file-changed --ignore-failed-read "${progress_args[@]}" -czpf - "${exclude_args[@]}" -C "$parent_dir" "$base_name" \
      | gpg --batch --yes --quiet --no-tty \
            --pinentry-mode loopback --passphrase-fd 3 \
            --symmetric --cipher-algo AES256 \
            --output "$archive_file" 3<<<"$password"
  fi
  local status=("${PIPESTATUS[@]}")
  set -e
  if [ "${status[0]}" -gt 1 ] || [ "${status[1]}" -ne 0 ]; then
    die "Backup failed (tar=${status[0]}, gpg=${status[1]})."
  fi
  trap - INT TERM EXIT

  echo "Backup complete: $archive_file"
}

cmd_restore() {
  local archive=""
  local dest="./restored"
  local password="${CHEST_PASSWORD:-}"
  local password_flag=0
  local verbose=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -i|--input)    need_arg "$@"; archive="$2"; shift 2 ;;
      -o|--output)   need_arg "$@"; dest="$2"; shift 2 ;;
      -p|--password) need_arg "$@"; password="$2"; password_flag=1; shift 2 ;;
      -v|--verbose)  verbose=1; shift ;;
      -h|--help)     usage; exit 0 ;;
      *)             die "Unknown option: $1" ;;
    esac
  done

  [ -n "$archive" ] || die "Missing input archive (-i / --input)."
  [ -f "$archive" ] || die "Archive '$archive' does not exist."

  # Detect the archive's encryption mode from its OpenPGP packets:
  # a ':symkey enc packet:' means passphrase (symmetric) encryption;
  # otherwise the archive was encrypted to a GPG public key.
  # gpg --list-packets does not need the password to inspect packets.
  local is_symmetric=0
  local packets
  # gpg may exit non-zero when it cannot decrypt the packet bodies while
  # listing; only the packet dump matters here, so ignore its exit status.
  packets="$(gpg --batch --pinentry-mode cancel --list-packets "$archive" 2>/dev/null || true)"
  [ -n "$packets" ] || die "'$archive' is not an OpenPGP-encrypted archive."
  if grep -q ':symkey enc packet:' <<<"$packets"; then
    is_symmetric=1
  fi

  # Decide where the passphrase comes from. CHEST_PASSWORD only applies to
  # symmetric archives; for public-key archives the private key's passphrase
  # is the gpg-agent's business unless -p was passed explicitly.
  local use_loopback=0
  if [ "$is_symmetric" -eq 1 ]; then
    ask_password restore
    use_loopback=1
  elif [ "$password_flag" -eq 1 ]; then
    # Explicit -p on a public-key archive: use it as the private key's passphrase.
    use_loopback=1
  else
    password=""
  fi

  local progress_args=()
  if [ "$verbose" -eq 1 ]; then
    progress_args+=(-v)
  elif [ -t 2 ]; then
    progress_args+=(--checkpoint=2500 --checkpoint-action='ttyout=  Extracting: %u\r')
  fi

  # Extract into a sibling staging directory and only move it into place once
  # gpg and tar both succeeded, so a wrong password or a truncated archive
  # leaves the destination untouched.
  local staging="${dest%/}.partial.$$"
  rm -rf "$staging"
  mkdir -p "$staging"
  # Expand the path into the trap: the local variable is gone by the time an
  # EXIT trap fires, which would trip `set -u`.
  trap "rm -rf $(printf '%q' "$staging")" INT TERM EXIT

  echo "Restoring '$archive' -> '$dest'..."

  set +e
  if [ "$use_loopback" -eq 1 ]; then
    gpg --batch --yes --quiet --no-tty \
        --pinentry-mode loopback --passphrase-fd 3 \
        --decrypt "$archive" 3<<<"$password" \
      | tar "${progress_args[@]}" -xzpf - -C "$staging"
  else
    # Public-key archive without a password: gpg-agent supplies the private
    # key and runs its own pinentry if the passphrase is not cached yet.
    # --batch only stops gpg itself from asking questions; the agent's
    # pinentry still works, and unattended runs fail fast instead of hanging.
    gpg --batch --yes --quiet \
        --decrypt "$archive" \
      | tar "${progress_args[@]}" -xzpf - -C "$staging"
  fi
  local status=("${PIPESTATUS[@]}")
  set -e
  if [ "${status[0]}" -ne 0 ] || [ "${status[1]}" -ne 0 ]; then
    rm -rf "$staging"
    trap - INT TERM EXIT
    if [ "$use_loopback" -eq 0 ] && [ "${status[0]}" -ne 0 ]; then
      die "Decryption failed. This archive is encrypted to a public key: gpg-agent needs the matching private key, plus a pinentry or a preset passphrase to unlock it (see README section 4)."
    fi
    die "Restore failed (gpg=${status[0]}, tar=${status[1]})."
  fi

  mkdir -p "$dest"
  shopt -s dotglob nullglob
  local staged=("$staging"/*)
  shopt -u dotglob nullglob
  [ "${#staged[@]}" -eq 0 ] || mv -- "${staged[@]}" "$dest"/
  trap - INT TERM EXIT
  rm -rf "$staging"

  echo "Restore complete: $dest"
}

# Main entrypoint
case "${1:-}" in
  backup)  shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  -h|--help|help|"") usage ;;
  *) die "Unknown command: $1. Use 'chest --help'." ;;
esac
