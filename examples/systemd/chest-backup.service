# ~/.config/systemd/user/chest-backup.service
# Weekly encrypted backup, run as your own user (no root needed).
# Install together with chest-backup.timer.
# See README section 4 (key setup) and "Scheduling with systemd".

[Unit]
Description=chest encrypted backup

[Service]
Type=oneshot
# Symmetric mode: source the password file (chmod 600, owned by you).
# Not needed with public-key encryption (-r) — there CHEST_PASSWORD is
# ignored, so you can also leave this line out entirely.
EnvironmentFile=%h/.config/chest/env
ExecStart=%h/.local/bin/chest backup -s %h -o %h/backups
# Public-key mode alternative (no secret on this machine):
# ExecStart=%h/.local/bin/chest backup -s %h -o %h/backups -r you@example.com

[Install]
WantedBy=default.target
